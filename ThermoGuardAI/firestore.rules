rules_version = '2';
// ============================================================
// ThermoGuard AI — Cloud Firestore security rules
//
// The BACKEND is the primary authorization boundary and the ONLY writer to
// Firestore (Firebase Admin SDK bypasses these rules). The React frontend
// never reads or writes Firestore directly — it talks exclusively to the
// backend API, which enforces authentication, role-based access control and
// organization isolation server-side.
//
// Therefore all direct client access is DENIED. There is no per-document
// allowance for end users; any client-side operation fails with
// PERMISSION_DENIED. This is defense-in-depth on top of the backend.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    // Deny everything by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
