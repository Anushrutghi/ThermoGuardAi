# ---------------------------------------------------------------------------
# ThermoGuard AI — environment template
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is gitignored).
# Never put production credentials in any file that is committed.
#
# Three configuration tiers share the same variables:
#   development  — APP_ENV=development (permissive defaults, localhost origins)
#   staging      — APP_ENV=staging     (explicit origins, strong secrets)
#   production   — APP_ENV=production  (FAILS TO START on unsafe config:
#                   weak SECRET_KEY, wildcard CORS, debug on, empty ALLOWED_HOSTS)
#
# The backend refuses to start in production unless the security validation
# passes (see backend/core/config.py -> validate_security()).

# --- Application -----------------------------------------------------------
APP_ENV=development            # development | staging | production
DEBUG=false                    # must be false in production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
API_HOST=0.0.0.0
API_PORT=8000

# --- Security (CRITICAL in production) --------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string   # >= 32 chars required in production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480         # token lifetime in minutes (8h default)

# --- Database ---------------------------------------------------------------
# SQLite (single-node, default):
DATABASE_URL=sqlite:///./database/thermoguard.db
# PostgreSQL (recommended for multi-worker production):
# DATABASE_URL=postgresql+psycopg://thermoguard:CHANGE_ME@db:5432/thermoguard

# --- CORS / hosts -----------------------------------------------------------
# Explicit comma-separated origins. In production "*" is REJECTED at startup.
CORS_ORIGINS=http://localhost:8501,http://localhost:5173,http://localhost:3000
# Hostnames (no scheme/port) allowed by TrustedHostMiddleware in production.
# Include your real domain(s), e.g. dashboard.example.com,api.example.com
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Detection / AI ---------------------------------------------------------
MODEL_PATH=models/electrical_yolo.pt
DETECTOR_MODE=auto             # auto | yolo | fallback
CONFIDENCE_THRESHOLD=0.35
NMS_THRESHOLD=0.45
INFERENCE_DEVICE=auto          # auto | cpu | cuda | mps
ALLOW_GENERIC_MODEL=false      # must stay false — dishonesty guard

# --- Thermal subsystem ------------------------------------------------------
# auto | simulator | mlx90640 | lepton | amg8833 | seek
# "simulator" = DEMO / SIMULATED THERMAL (always labelled; never presented as real)
THERMAL_MODE=auto
THERMAL_AMBIENT_C=25.0
# S4 frame validation bounds (°C) — values outside are INVALID (never analysed)
THERMAL_FRAME_MIN_C=-40.0
THERMAL_FRAME_MAX_C=300.0
THERMAL_MAX_INVALID_FRACTION=0.05
# Emissivity for sensors that support it (e.g. MLX90640 default 0.95). Leave
# unset (None) when unavailable — never invented.
# THERMAL_EMISSIVITY=0.95

# --- Switch-first inspection ------------------------------------------------
SWITCH_MIN_CONFIDENCE=0.55
SWITCH_STABLE_FRAMES=8
THERMAL_BASELINE_FRAMES=8
THERMAL_SCAN_FRAMES=15
THERMAL_ELEVATED_DELTA_C=10.0
THERMAL_ABNORMAL_DELTA_C=20.0
THERMAL_CRITICAL_DELTA_C=35.0
THERMAL_RAPID_RISE_C_PER_MIN=6.0

# --- Alarms -----------------------------------------------------------------
ALARM_SOUND_PATH=assets/sounds/alarm.wav
ALARM_EMAIL_ENABLED=false
ALARM_WEBHOOK_URL=

# --- Media / reports --------------------------------------------------------
MEDIA_DIR=media
REPORT_DIR=reports/generated
MAX_UPLOAD_MB=25

# --- Seed admin (development bootstrap only — override before production) ---
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_EMAIL=admin@thermoguard.local
SEED_ORGANIZATION=ThermoGuard

# ===========================================================================
# S6 — FIREBASE PRODUCTION INTEGRATION
# ===========================================================================
# The Firebase project YOU provide is the production data store + identity
# provider. The local SQLite/bcrypt backend stays as the DEVELOPMENT/TEST
# backend only (selected below). Production must use Firebase — never a local
# database service.
#
# NEVER commit: the service-account JSON, private keys, tokens, or real
# Firebase secret values. All secrets arrive via environment variables.

# --- Backend selection ------------------------------------------------------
# AUTH_BACKEND   local   = bcrypt + custom JWT (development/tests ONLY)
#                 firebase = Firebase Authentication ID-token verification
# STORAGE_BACKEND sqlite    = SQLAlchemy/SQLite (development/tests ONLY)
#                 firestore = Firestore (documents) + Firebase Storage (files)
# Production (APP_ENV=production) must use firebase/firestore.
AUTH_BACKEND=local
STORAGE_BACKEND=sqlite

# --- Backend Firebase Admin SDK (required when AUTH_BACKEND=firebase or
# --- STORAGE_BACKEND=firestore) ---------------------------------------------
# Path to the service-account JSON on the server. The FILE must never be
# committed or exposed; only its path is configured here.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/thermoguard-firebase-sa.json
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# --- Frontend (React) Firebase Web App config (public values) ---------------
# These are safe to embed in the SPA build (not secrets), but are left blank
# here — the deployed build must be configured with them:
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
#
# Legacy local login is only available when EXPLICITLY opted in for
# development/tests. Production builds must leave this unset:
# VITE_AUTH_MODE=local

# --- Firebase Emulator Suite (development/tests only — NEVER production) ----
# Point the SDKs at the local emulators so tests never touch the real project:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199
